{
  "name": "ovh-agent",
  "displayName": "TRINITY Agent",
  "description": "Open-source coding assistant for OVHcloud AI Endpoints and DeepSeek: archives, task resumption, steering and queued messages. Self-hosted backend required.",
  "version": "1.17.72",
  "icon": "media/trinity-icon.png",
  "ovhAgentBranding": {
    "lightThemeIcon": "media/trinity-icon.png",
    "darkThemeIcon": "media/trinity-activity.png"
  },
  "publisher": "trinity",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:ovhAgent.launch",
    "onCommand:ovhAgent.start",
    "onCommand:ovhAgent.selectProvider"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ovhAgent.start",
        "title": "%ovhAgent.start.title%",
        "category": "TRINITY Agent",
        "icon": {
          "light": "media/bi-robot-light.svg",
          "dark": "media/bi-robot-dark.svg"
        }
      },
      {
        "command": "ovhAgent.configureKey",
        "title": "%ovhAgent.configureKey.title%",
        "category": "TRINITY Agent",
        "icon": {
          "light": "media/bi-key-light.svg",
          "dark": "media/bi-key-dark.svg"
        }
      },
      {
        "command": "ovhAgent.configureBilling",
        "title": "%ovhAgent.configureBilling.title%",
        "category": "TRINITY Agent",
        "icon": {
          "light": "media/bi-wallet-light.svg",
          "dark": "media/bi-wallet-dark.svg"
        }
      },
      {
        "command": "ovhAgent.selectProvider",
        "title": "%ovhAgent.selectProvider.title%",
        "category": "TRINITY Agent"
      },
      {
        "command": "ovhAgent.selectProject",
        "title": "%ovhAgent.selectProject.title%",
        "category": "TRINITY Agent"
      },
      {
        "command": "ovhAgent.editProfile",
        "title": "%ovhAgent.editProfile.title%",
        "category": "TRINITY Agent"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ovhAgent",
          "title": "TRINITY Agent",
          "icon": "media/trinity-activity.png"
        }
      ]
    },
    "views": {
      "ovhAgent": [
        {
          "id": "ovhAgent.launch",
          "name": "TRINITY Agent",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "TRINITY Agent",
      "properties": {
        "ovhAgent.provider": {
          "type": "string",
          "enum": [
            "ovhcloud",
            "deepseek"
          ],
          "default": "ovhcloud",
          "scope": "machine",
          "description": "Inference provider. DeepSeek uses a separate API key and USD cost estimates. Local inference budgets and request/token ceilings are disabled for DeepSeek; provider limits and file verification still apply. A change restarts an idle backend and applies to the next message; an active task finishes first."
        },
        "ovhAgent.backendPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the TRINITY Agent companion launcher on the extension host. Requires the self-hosted Python backend."
        },
        "ovhAgent.performanceMode": {
          "type": "string",
          "enum": [
            "auto",
            "max"
          ],
          "default": "auto",
          "scope": "machine",
          "description": "%ovhAgent.performanceMode.description%",
          "enumDescriptions": [
            "%ovhAgent.performanceMode.auto%",
            "%ovhAgent.performanceMode.max%"
          ]
        }
      }
    }
  },
  "dependencies": {
    "dompurify": "latest",
    "markdown-it": "latest",
    "sanitize-html": "latest"
  },
  "devDependencies": {
    "@fortawesome/free-solid-svg-icons": "latest",
    "@highlightjs/cdn-assets": "latest",
    "@vscode/vsce": "latest",
    "bootstrap-icons": "latest",
    "jsdom": "latest",
    "terser": "latest"
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "build:icons": "node scripts/build-icons.cjs",
    "build:highlighting": "node scripts/build-highlighting.cjs",
    "package:vsix": "node scripts/package-vsix.cjs",
    "build:frontend": "node scripts/build-frontend.cjs",
    "dependencies:latest": "npm update --include=dev --ignore-scripts --no-fund && npm run build:vendor",
    "build:vendor": "node scripts/build-vendor.cjs"
  },
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "https://github.com/trinity-labs/trinity-agent.git",
    "directory": "ovh-agent-extension/extension"
  },
  "pricing": "Free",
  "homepage": "https://github.com/trinity-labs/trinity-agent",
  "bugs": {
    "url": "https://github.com/trinity-labs/trinity-agent/issues"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The agent can run commands and modify files."
    },
    "virtualWorkspaces": false
  }
}
