{
  "name": "trinity-agent",
  "displayName": "TRINITY Agent",
  "description": "Open-source coding assistant and multi-provider model API relay for OpenAI Codex, OVHcloud AI Endpoints and DeepSeek.",
  "version": "5.1.0",
  "icon": "media/trinity-icon.png",
  "trinityAgentBranding": {
    "lightThemeIcon": "media/trinity-icon.png",
    "darkThemeIcon": "media/trinity-activity.png"
  },
  "publisher": "trinity",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:trinityAgent.launch",
    "onCommand:trinityAgent.start",
    "onCommand:trinityAgent.selectProvider"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "trinityAgent.start",
        "title": "%trinityAgent.start.title%",
        "category": "TRINITY Agent",
        "icon": {
          "light": "media/trinity-title-black.png",
          "dark": "media/trinity-header-white.png"
        }
      },
      {
        "command": "trinityAgent.configureKey",
        "title": "%trinityAgent.configureKey.title%",
        "category": "TRINITY Agent",
        "icon": {
          "light": "media/bi-key-light.svg",
          "dark": "media/bi-key-dark.svg"
        }
      },
      {
        "command": "trinityAgent.configureBilling",
        "title": "%trinityAgent.configureBilling.title%",
        "category": "TRINITY Agent",
        "icon": {
          "light": "media/bi-wallet-light.svg",
          "dark": "media/bi-wallet-dark.svg"
        }
      },
      {
        "command": "trinityAgent.selectProvider",
        "title": "%trinityAgent.selectProvider.title%",
        "category": "TRINITY Agent"
      },
      {
        "command": "trinityAgent.selectProject",
        "title": "%trinityAgent.selectProject.title%",
        "category": "TRINITY Agent"
      },
      {
        "command": "trinityAgent.editProfile",
        "title": "%trinityAgent.editProfile.title%",
        "category": "TRINITY Agent"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "trinityAgent.start",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "trinityAgent",
          "title": "TRINITY Agent",
          "icon": "media/trinity-menu.png"
        }
      ]
    },
    "views": {
      "trinityAgent": [
        {
          "id": "trinityAgent.launch",
          "name": "TRINITY Agent",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "TRINITY Agent",
      "properties": {
        "trinityAgent.provider": {
          "type": "string",
          "enum": [
            "ovhcloud",
            "deepseek",
            "openai"
          ],
          "default": "ovhcloud",
          "scope": "machine",
          "description": "Model API used for this conversation. OVHcloud, DeepSeek and OpenAI each keep their own key, endpoint, catalogue, token limits and account display. A change restarts an idle backend and applies to the next message; an active task finishes first."
        },
        "trinityAgent.backendPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the TRINITY Agent companion launcher on the extension host. Requires the self-hosted Python backend."
        },
        "trinityAgent.performanceMode": {
          "type": "string",
          "enum": [
            "auto",
            "max"
          ],
          "default": "auto",
          "scope": "machine",
          "description": "%trinityAgent.performanceMode.description%",
          "enumDescriptions": [
            "%trinityAgent.performanceMode.auto%",
            "%trinityAgent.performanceMode.max%"
          ]
        }
      }
    }
  },
  "dependencies": {
    "dompurify": "latest",
    "markdown-it": "latest",
    "sanitize-html": "latest"
  },
  "devDependencies": {
    "@fortawesome/free-solid-svg-icons": "latest",
    "@highlightjs/cdn-assets": "latest",
    "@vscode/vsce": "latest",
    "bootstrap-icons": "latest",
    "jsdom": "latest",
    "terser": "latest"
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "build:icons": "node scripts/build-icons.cjs",
    "build:highlighting": "node scripts/build-highlighting.cjs",
    "package:vsix": "node scripts/package-vsix.cjs",
    "build:frontend": "node scripts/build-frontend.cjs",
    "dependencies:latest": "npm update --include=dev --ignore-scripts --no-fund && npm run build:vendor",
    "build:vendor": "node scripts/build-vendor.cjs"
  },
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "https://github.com/trinity-labs/trinity-agent.git",
    "directory": "extension"
  },
  "pricing": "Free",
  "homepage": "https://github.com/trinity-labs/trinity-agent",
  "bugs": {
    "url": "https://github.com/trinity-labs/trinity-agent/issues"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The agent can run commands and modify files."
    },
    "virtualWorkspaces": false
  }
}
